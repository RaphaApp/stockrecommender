# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# "Secrets" panel. NEVER commit a real secrets.toml to source control.
#
# Stocktwits — APPROVED API credentials only (not a consumer login). Without these
# the app makes NO Stocktwits request and shows "not configured".
# STOCKTWITS_API_USERNAME = ""
# STOCKTWITS_API_PASSWORD = ""
#
# Optional, unchanged from earlier releases:
# DATABASE_URL = ""        # Supabase/Postgres session pooler URL
# FMP_API_KEY = ""
# SEC_USER_AGENT = ""
